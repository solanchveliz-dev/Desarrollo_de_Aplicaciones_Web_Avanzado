<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post ? 'Editar post' : 'Nuevo post' %> - Social Media</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
</head>
<body class="app-shell">
  <nav class="app-nav">
    <div class="nav-wrapper">
      <div class="container">
        <a href="/posts" class="brand-logo">Social Media</a>
      </div>
    </div>
  </nav>

  <main class="container page-wrap">
    <div class="row">
      <div class="col s12 m9 l8 offset-m1 offset-l2">
        <div class="form-panel">
          <h1><%= post ? 'Editar publicación' : 'Crear publicación' %></h1>
          <p class="form-intro">Completa los datos de tu publicación.</p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="card-panel error-panel">
              <i class="material-icons left">error</i><%= error %>
            </div>
          <% } %>

          <form action="<%= action %>" method="POST">
            <% const currentUserId = (typeof selectedUserId !== 'undefined' ? selectedUserId : '') || (post && post.user ? post.user._id : post && post.userId ? post.userId : ''); %>
            <div class="input-field">
              <i class="material-icons prefix">person</i>
              <select id="userId" name="userId" required>
                <option value="" disabled <%= currentUserId ? '' : 'selected' %>>Selecciona un usuario</option>
                <% users.forEach((user) => { %>
                  <option value="<%= user._id %>" <%= currentUserId && currentUserId.toString() === user._id.toString() ? 'selected' : '' %>>
                    <%= user.name %> <%= user.lastName %>
                  </option>
                <% }) %>
              </select>
              <label for="userId">Usuario</label>
            </div>

            <div class="input-field">
              <i class="material-icons prefix">title</i>
              <input id="title" name="title" type="text" minlength="5" maxlength="30" value="<%= post ? post.title : '' %>" required>
              <label for="title">Título</label>
              <span class="helper-text">Entre 5 y 30 caracteres</span>
            </div>

            <div class="input-field">
              <i class="material-icons prefix">subject</i>
              <textarea id="content" name="content" class="materialize-textarea" minlength="10" required><%= post ? post.content : '' %></textarea>
              <label for="content">Contenido</label>
            </div>

            <div class="input-field">
              <i class="material-icons prefix">tag</i>
              <input id="hashtags" name="hashtags" type="text" value="<%= post && post.hashtags ? post.hashtags.join(', ') : '' %>">
              <label for="hashtags">Hashtags</label>
              <span class="helper-text">Sepáralos con comas</span>
            </div>

            <div class="input-field">
              <i class="material-icons prefix">image</i>
              <input id="imageUrl" name="imageUrl" type="url" value="<%= post ? post.imageUrl || '' : '' %>">
              <label for="imageUrl">URL directa de la imagen</label>
              <span class="helper-text">Usa el enlace directo a un archivo de imagen.</span>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-app waves-effect waves-light">
                <i class="material-icons left">save</i>Guardar publicación
              </button>
              <a href="/posts" class="btn-flat">Cancelar</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      M.updateTextFields();
      M.FormSelect.init(document.querySelectorAll('select'));
    });
  </script>
</body>
</html>
